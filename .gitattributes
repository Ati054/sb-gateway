# WSL/Linux entrypoints must retain LF shebangs on Windows checkouts.
*.sh text eol=lf
# Runtime templates are also consumed by LF-based startup migrations.
*.j2 text eol=lf
# Unified diff context has a mandatory space before Go's tab indentation.
*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol

# A public source snapshot is created only from tracked release files. Internal
# lab automation and private-agent metadata never enter it. Sanitized tests
# remain in the public snapshot and are executed by release CI.
.agents export-ignore
.agents/** export-ignore
.codex export-ignore
.codex/** export-ignore
.openai export-ignore
.openai/** export-ignore
.lab export-ignore
.lab/** export-ignore
AGENTS.md export-ignore
CODEX_HANDOFF.md export-ignore
IMPLEMENTATION_REPORT.md export-ignore
QUATTRO_SERVERS_AUDIT.md export-ignore
docs/ACCEPTANCE-TESTS.md export-ignore
docs/research export-ignore
docs/research/** export-ignore
docs/*-VERIFICATION.md export-ignore
