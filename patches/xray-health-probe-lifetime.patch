diff --git a/transport/internet/reality/sb_lifetime_test.go b/transport/internet/reality/sb_lifetime_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/reality/sb_lifetime_test.go
@@ -0,0 +1,66 @@
+package reality
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+)
+
+type sbTrackedConn struct {
+	net.Conn
+	closed atomic.Int32
+}
+
+func (c *sbTrackedConn) Close() error {
+	c.closed.Add(1)
+	return c.Conn.Close()
+}
+
+func TestSBRealityFailureClosesOwnedSocket(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"invalid-key", "invalid-fingerprint", "read-timeout", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			raw, peer := net.Pipe()
+			conn := &sbTrackedConn{Conn: raw}
+			defer raw.Close()
+			defer peer.Close()
+			config := &Config{ServerName: "example.org", Fingerprint: "chrome", PublicKey: key.PublicKey().Bytes()}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			switch mode {
+			case "invalid-key":
+				config.PublicKey = nil
+			case "invalid-fingerprint":
+				config.Fingerprint = "unsupported-sb-test"
+			case "read-timeout":
+				conn.SetDeadline(time.Now().Add(100 * time.Millisecond))
+			case "cancel":
+				cancel()
+			}
+			drained := make(chan struct{})
+			go func() { io.Copy(io.Discard, peer); close(drained) }()
+			result, err := UClient(conn, config, ctx, xnet.TCPDestination(xnet.ParseAddress("example.org"), 443))
+			if result != nil || err == nil {
+				t.Fatalf("failed handshake returned %v, %v", result, err)
+			}
+			if conn.closed.Load() == 0 {
+				t.Fatal("failed handshake retained its owned socket")
+			}
+			select {
+			case <-drained:
+			case <-time.After(time.Second):
+				t.Fatal("peer did not observe failed socket closure")
+			}
+		})
+	}
+}
