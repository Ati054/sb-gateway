diff --git a/infra/conf/sb_reality_warning_test.go b/infra/conf/sb_reality_warning_test.go
new file mode 100644
index 0000000..da9d3bc
--- /dev/null
+++ b/infra/conf/sb_reality_warning_test.go
@@ -0,0 +1,74 @@
+package conf
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/log"
+)
+
+type sbRealityWarningLog struct {
+	sync.Mutex
+	messages []string
+}
+
+func (h *sbRealityWarningLog) Handle(m log.Message) {
+	h.Lock()
+	defer h.Unlock()
+	h.messages = append(h.messages, m.String())
+}
+
+func TestSBRealityAdvisoriesOnceAcrossConfigBuilds(t *testing.T) {
+	sbRealityTargetWarning = sync.Once{}
+	sbRealityPortWarning = sync.Once{}
+	h := &sbRealityWarningLog{}
+	log.RegisterHandler(h)
+	t.Cleanup(func() {
+		log.RegisterHandler(log.NewLogger(log.CreateStdoutLogWriter()))
+		sbRealityTargetWarning = sync.Once{}
+		sbRealityPortWarning = sync.Once{}
+	})
+	const fixture = `{"inbounds":[{"port":2443,"protocol":"vless","settings":{"decryption":"none","clients":[{"id":"00000000-0000-0000-0000-000000000001"}]},"streamSettings":{"network":"tcp","security":"reality","realitySettings":{"target":"example.com:443","serverNames":["mask.example.ru","other.example.ru"],"privateKey":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","shortIds":["0123456789abcdef"]}}}],"outbounds":[{"protocol":"freedom"}]}`
+	var group sync.WaitGroup
+	for range 32 {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			var c Config
+			if err := json.Unmarshal([]byte(fixture), &c); err != nil {
+				t.Error(err)
+				return
+			}
+			if _, err := c.Build(); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	group.Wait()
+	for range 2 {
+		errors.LogWarning(context.Background(), "sb-ordinary-warning")
+		errors.LogError(context.Background(), "sb-runtime-error")
+	}
+	var invalid Config
+	if err := json.Unmarshal([]byte(strings.Replace(fixture, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "invalid", 1)), &invalid); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := invalid.Build(); err == nil {
+		t.Fatal("invalid REALITY key accepted")
+	}
+	for fragment, want := range map[string]int{"REALITY: Choosing": 1, "REALITY: Listening on non-443": 1, "sb-ordinary-warning": 2, "sb-runtime-error": 2} {
+		count := 0
+		for _, m := range h.messages {
+			if strings.Contains(m, fragment) {
+				count++
+			}
+		}
+		if count != want {
+			t.Errorf("%s: got %d, want %d", fragment, count, want)
+		}
+	}
+}
