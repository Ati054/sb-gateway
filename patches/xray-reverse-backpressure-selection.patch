+// Only Reverse portals track blocked writes; ordinary Mux is unchanged.
+type sbDownlinkWriter struct {
+	destination buf.Writer
+	started     atomic.Int64
+}
+
+func (w *sbDownlinkWriter) WriteMultiBuffer(data buf.MultiBuffer) error {
+	w.started.Store(time.Since(sbDownlinkEpoch).Nanoseconds())
+	defer w.started.Store(0)
+	return w.destination.WriteMultiBuffer(data)
+}
+
+func (m *ClientWorker) DownlinkBlockedFor() time.Duration {
+	if m.downlinkOutput == nil {
+		return 0
+	}
+	started := m.downlinkOutput.started.Load()
+	if started == 0 {
+		return 0
+	}
+	return time.Since(sbDownlinkEpoch) - time.Duration(started)
