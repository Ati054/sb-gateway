# sb-gateway-nginx-schema: 3
user www-data;
worker_processes 1;
pid /run/nginx.pid;
error_log /logs/nginx/error.log warn;

${SHARED_STREAM}

events {
    worker_connections 1024;
}

http {
${ORIGIN_MAPS}
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    server_names_hash_bucket_size 64;
    log_format management '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';
    access_log off;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 2m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:2m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    root ${DECOY_ROOT};
    index index.html;

${DECOY_HTTP_SERVER}

${DEFAULT_PUBLIC_SERVER}

${REALITY_COVER_SERVER}

${DECOY_HTTPS_SERVER}

${WS_SERVER}

${GRPC_SERVER}

${HU_SERVER}

${XHTTP_SERVER}

${STATUS_SERVER}

${SUBSCRIPTION_SERVER}

    server {
        listen 9443 ssl;
        server_name _;
        # Ordinary configuration payloads are commonly larger than Nginx's
        # platform-dependent default buffer. Keep them in a small bounded RAM
        # buffer so RouterOS flash is not touched on every save, while retaining
        # a writable runtime-only spill directory for unusually large requests.
        client_body_buffer_size 256k;
        client_body_temp_path /run/sb-gateway/nginx-client-body 1 2;
        ssl_certificate ${MANAGEMENT_TLS_CERT};
        ssl_certificate_key ${MANAGEMENT_TLS_KEY};
        access_log off;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store" always;

        root /opt/sb-gateway/web/out;
        index index.html;

        # Next.js content-hashed assets are immutable.  Let a browser retain
        # them across an appliance restart/update so the hydrated interface
        # never falls back to unstyled server-rendered HTML while the new
        # container is becoming ready.  HTML, API and subscription responses
        # keep the server-wide no-store policy below.
        location ^~ /_next/static/ {
            access_log off;
            try_files $uri =404;
            add_header X-Frame-Options DENY always;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        # Only the one-time bootstrap receives the appliance bearer.  Normal
        # API traffic must authenticate with the administrator session.
        location = /api/v1/auth/bootstrap {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization "Bearer ${MANAGEMENT_TOKEN}";
            proxy_buffering off;
            proxy_pass http://127.0.0.1:8080;
        }

        # Safe Mode apply and rollback legitimately outlive the default
        # 60-second proxy timeout while RouterOS health checks complete.
        # Keep the longer timeout scoped to these two authenticated actions.
        location ~ ^/api/v1/drafts/(apply|rollback)$ {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            proxy_pass http://127.0.0.1:8080;
        }

        # A signed-in administrator can upload one RouterOS Docker archive.
        # Keep the large-body allowance and long streaming timeout restricted
        # to this exact CSRF-protected endpoint; every other API route stays at
        # the global 2 MiB limit.
        location = /api/v1/lifecycle/image-upload {
            client_max_body_size 2048m;
            client_body_timeout 1800s;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 1800s;
            proxy_send_timeout 1800s;
            proxy_pass http://127.0.0.1:8080;
        }

        # Creating the mandatory encrypted recovery copy and staging the
        # RouterOS one-shot worker can take several minutes on slow flash.
        location = /api/v1/lifecycle/image-update {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            proxy_pass http://127.0.0.1:8080;
        }

        # Decrypting and staging an appliance recovery plus installing the
        # RouterOS one-shot restart can exceed the generic 60-second timeout.
        # Keep the exception scoped to this CSRF-protected, re-authenticated
        # endpoint so ordinary API failures still surface quickly.
        location = /api/v1/recovery/restore {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_pass http://127.0.0.1:8080;
        }

        location /api/ {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_pass http://127.0.0.1:8080;
        }

        location / {
            try_files $uri $uri.html $uri/ /index.html;
        }
    }

    server {
        listen 9080;
        server_name _;
        allow 127.0.0.1;
        allow ${ROUTEROS_GATEWAY};
        deny all;
        access_log off;

        location = /healthz {
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1;
            proxy_pass http://127.0.0.1:8080/api/health/router-ready;
        }
        location = /traffic-ready {
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_pass http://127.0.0.1:8080/api/health/traffic-ready;
        }
        location / { return 404; }
    }

    # Private subscription relay for an explicitly allowlisted lab source.
    # The production RouterOS candidate does not publish this port.
    server {
        listen 9081;
        server_name _;
        allow ${SUBSCRIPTION_RELAY_SOURCE};
        deny all;
        access_log off;
        error_log /logs/nginx/subscription-relay-error.log crit;

        location ~ "^/[A-Za-z0-9_-]{43,128}$" {
            limit_except GET { deny all; }
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_buffering off;
            proxy_pass http://127.0.0.1:8080;
        }
        location / { return 404; }
    }
}
